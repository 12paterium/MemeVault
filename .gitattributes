# Normalize line endings to LF in the repository; check out as-is
* text=auto

# Python and config sources
*.py text
*.toml text
*.md text
*.gitignore text
*.gitattributes text
*.editorconfig text

# Windows scripts
*.bat text eol=crlf

# Images and binary artifacts
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.webp binary
*.ico binary
*.npz binary
